                                                    "Command",
                                                    "Event",
                                                    "Flow Control"
                                                ],
                                                "enumDescriptions": [
                                                    "All message types.",
                                                    "Commands sent to the agent (C) and their results (R, P and N).",
                                                    "Events from the agent (E).",
                                                    "Flow control messages (F). They have no service or name."
                                                ]
                                            },
                                            "default": [
