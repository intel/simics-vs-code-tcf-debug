    "scripts": {
        "build": "npm run typecheck && npm run compile",
        "check": "npm run typecheck && npm test",
        "compile": "node esbuild.mjs",
        "compile:production": "node esbuild.mjs --production",
        "watch": "node esbuild.mjs --watch",
        "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.webview.json && tsc --noEmit -p src/launchSettings/webview",
        "format": "prettier --write .",
        "test": "node esbuild.mjs --tests && node --enable-source-maps --test \"out/test/*.test.js\"",
        "test:fuzz": "node esbuild.mjs --tests && node --enable-source-maps --test out/test/fuzzing.test.js",
        "vscode:prepublish": "npm run typecheck && npm run compile:production",
        "package": "vsce package --no-dependencies"
    },
